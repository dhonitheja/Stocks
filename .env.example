# ============================================================
#  .env — Secret keys (NEVER commit this file to Git!)
#  Copy this to .env and fill in your values.
# ============================================================

# ─── Broker Selection ────────────────────────────────────────
# Which broker to use: alpaca (default) | robinhood
BROKER=alpaca

# ─── Alpaca Broker API (US Markets — Free) ───────────────────
# 1. Sign up at https://alpaca.markets (no minimums, no commission)
# 2. Go to Paper Trading → API Keys → Generate
# 3. Paste keys below
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# true = paper trading (fake money), false = live trading (real money)
ALPACA_PAPER=true

# ─── Robinhood (Optional — unofficial API) ───────────────────
# Only needed if BROKER=robinhood
# Note: Uses robin_stocks (private API) — personal use only
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_MFA_CODE=   # Leave blank if 2FA not enabled; or TOTP code

# ─── News & Data APIs ────────────────────────────────────────
# NewsAPI: https://newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (free tier available)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ─── AI / LLM APIs — Pick ONE (or set multiple as fallback) ─
# Grok (xAI) — RECOMMENDED if you already have a key
#   Sign up: https://console.x.ai  (API uses OpenAI-compatible format)
XAI_API_KEY=your_grok_api_key_here

# Google Gemini — free tier available
#   Sign up: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI — optional fallback
OPENAI_API_KEY=your_openai_api_key_here

# Which LLM to use: grok | gemini | openai
LLM_PROVIDER=grok
# Anthropic Claude: https://console.anthropic.com (for code review + QA agents)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksage
DB_USER=stocksage_user
DB_PASSWORD=change_this_strong_password

# ─── Cache (Redis) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Notifications (Optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── App Settings ────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=generate_a_random_32char_string_here

# ─── Research skills (read-only market data; see docs/research-skills.md) ──
# Any one is enough; more gives automatic fallback. ALPHA_VANTAGE_KEY above is reused.
FINNHUB_API_KEY=your_finnhub_key_here
POLYGON_API_KEY=your_polygon_key_here
